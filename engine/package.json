{
  "name": "mnemopolis-engine",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "course": "node scripts/use-course.mjs",
    "dev": "node scripts/use-course.mjs && vite",
    "check": "node scripts/use-course.mjs && node scripts/check.mjs",
    "build": "node scripts/use-course.mjs && node scripts/check.mjs && vite build",
    "shots": "node scripts/tour.mjs",
    "shots:phone": "PHONE=1 node scripts/tour.mjs",
    "test": "node scripts/use-course.mjs && node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
