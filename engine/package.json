{
  "name": "mnemopolis-engine",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "course": "node scripts/use-course.mjs",
    "dev": "node scripts/use-course.mjs && vite",
    "check": "node scripts/use-course.mjs && node scripts/check.mjs",
    "build": "node scripts/use-course.mjs && node scripts/check.mjs && vite build",
    "stress": "node scripts/use-course.mjs && node scripts/stress-town.mjs",
    "doors": "node scripts/doors.mjs",
    "shots": "node scripts/tour.mjs",
    "shots:phone": "PHONE=1 node scripts/tour.mjs",
    "shots:lab": "node scripts/labshots.mjs",
    "shots:life": "node scripts/lifeshots.mjs && PHONE=1 node scripts/lifeshots.mjs",
    "shots:locks": "OUT2=${OUT2:-/tmp} node scripts/lockshots.mjs && OUT2=${OUT2:-/tmp} PHONE=1 node scripts/lockshots.mjs",
    "test": "node scripts/use-course.mjs && node --test \"tests/*.test.mjs\"",
    "build:player": "node scripts/build-player.mjs",
    "shots:ready": "node scripts/readyshots.mjs",
    "build:play": "vite build --config vite.play.config.js"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
