   "lab": {
    "title": "Reveal",
    "stations": [
     {
      "id": "circle",
      "tab": "Circle area",
      "goal": "The area of a circle grows with the square of its radius.",
      "pattern": "cause-effect",
      "object": "Fixture object.",
      "action": "Acts on it.",
      "surprise": "Fixture surprise.",
      "predict": {
       "q": "Double the radius. The area becomes...",
       "options": [
        "twice as big",
        "four times as big",
        "the same"
       ],
       "answer": 1
      },
      "tries": [
       {
        "text": "Set the radius to 2 cm.",
        "when": {
         "reach": {
          "control": "r",
          "value": 2
         }
        }
       },
       {
        "text": "Double it to 4 cm and read the area.",
        "when": {
         "reach": {
          "control": "r",
          "value": 4
         }
        }
       }
      ],
      "takeaway": "Fixture takeaway with <b>bold</b>.",
      "source": "A test fixture of the ready-made patterns.",
      "ready": {
       "kind": "slider-reveal",
       "caption": "A circle and its area",
       "controls": [
        {
         "id": "r",
         "label": "Radius",
         "min": 0.5,
         "max": 4,
         "step": 0.1,
         "value": 1,
         "unit": "cm"
        }
       ],
       "vars": {
        "A": "pi*r^2"
       },
       "plot": {
        "x": {
         "min": 0,
         "max": 4,
         "label": "radius (cm)"
        },
        "y": {
         "min": 0,
         "max": 52,
         "label": "area (cm²)"
        }
       },
       "layers": [
        {
         "shapes": [
          {
           "circle": [
            50,
            50,
            "10*r"
           ],
           "color": "accent",
           "opacity": 0.85,
           "glow": true
          },
          {
           "text": "r = {r:1} cm",
           "at": [
            50,
            92
           ],
           "size": 7
          }
         ]
        },
        {
         "region": [
          3,
          4
         ],
         "when": "r >= 3",
         "label": "more than 28 cm²"
        },
        {
         "curve": "pi*x^2",
         "label": "area = π r²"
        },
        {
         "marker": [
          "r",
          "A"
         ],
         "label": "{A:1} cm²"
        },
        {
         "readout": "Double the radius: area × 4. Now {A:1} cm²"
        }
       ]
      }
     }
    ]
   },
