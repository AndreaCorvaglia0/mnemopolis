{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course knowledge base",
  "description": "A course as data. Concepts are listed in the order of the learning path. Limits on counts and lengths are checked by scripts/validate.mjs.",
  "type": "object",
  "required": [
    "version",
    "id",
    "language",
    "title",
    "subject",
    "bigIdea",
    "themes",
    "concepts",
    "relations",
    "finalCheck"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique slug. Also the key of the learner's saved progress."
    },
    "language": {
      "type": "string",
      "description": "Language of the course, e.g. en, it."
    },
    "title": {
      "type": "string",
      "description": "Name of the course as the learner sees it."
    },
    "subject": {
      "type": "string",
      "description": "One line: what the course is about."
    },
    "bigIdea": {
      "type": "string",
      "description": "One claim, 28 words at most, from which the course follows."
    },
    "learner": {
      "type": "string",
      "description": "Who it is for and what they already know."
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the learner can do at the end. Each starts with a verb."
    },
    "credit": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tier"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "idea"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "name": {
            "type": "string"
          },
          "idea": {
            "type": "string",
            "description": "The theme as one sentence, 18 words at most."
          },
          "cue": {
            "type": "object",
            "additionalProperties": false,
            "description": "A memory cue for the theme. All themes must differ.",
            "properties": {
              "landscape": {
                "enum": [
                  "river",
                  "shore",
                  "forest",
                  "meadow",
                  "hill"
                ]
              },
              "landmark": {
                "enum": [
                  "fountain",
                  "obelisk",
                  "statue",
                  "arch",
                  "bell",
                  "stones"
                ]
              },
              "why": {
                "type": "string",
                "description": "The link with the content, only if an honest one exists."
              }
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "requires",
              "part-of",
              "causes",
              "contrasts",
              "same-structure",
              "example-of",
              "used-in"
            ],
            "description": "Read as: from <type> to. 'requires' means from cannot be understood without to."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "finalCheck": {
      "type": "object",
      "required": [
        "name",
        "size",
        "pass"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 4,
          "maximum": 20
        },
        "pass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": [
        "id",
        "theme",
        "type",
        "name",
        "place",
        "objective",
        "idea",
        "wrongBelief",
        "remember",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "boolean",
          "default": true,
          "description": "Optional. false makes this an extra concept: its house stays in town for the curious, but the main story (about an hour) and the final check do not need it. Keep a core of roughly 4 to 6 concepts. See references/3-path.md (core and extra)."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "theme": {
          "type": "string"
        },
        "type": {
          "enum": [
            "mechanism",
            "process",
            "view",
            "parts",
            "choice",
            "cases",
            "story",
            "deep"
          ]
        },
        "name": {
          "type": "string",
          "description": "The concept, 2 to 5 words."
        },
        "place": {
          "type": "string",
          "description": "A short, picturable name for where this concept lives."
        },
        "sign": {
          "type": "string",
          "maxLength": 9
        },
        "objective": {
          "type": "string",
          "description": "What the learner will be able to do. Starts with an observable verb."
        },
        "idea": {
          "type": "string",
          "description": "The concept as one sentence, 28 words at most."
        },
        "wrongBelief": {
          "type": "string",
          "description": "What people believe before. Drives the prediction, the surprise and the wrong options."
        },
        "anchor": {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "analogy",
                "metaphor",
                "example",
                "contrast"
              ]
            },
            "text": {
              "type": "string"
            },
            "limits": {
              "type": "string",
              "description": "Where the anchor stops being true."
            }
          }
        },
        "application": {
          "type": "string",
          "description": "Where the learner will meet this in real life. Specific."
        },
        "remember": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "explain": {
          "type": "object",
          "required": [
            "q",
            "a"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "string"
            },
            "a": {
              "type": "string"
            }
          }
        },
        "callbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "how"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "string"
              },
              "how": {
                "type": "string"
              }
            }
          }
        },
        "lab": {
          "type": "object",
          "required": [
            "title",
            "stations"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "stations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/station"
              }
            }
          }
        },
        "page": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "description": "Under about 120 words."
              },
              "figure": {
                "type": "object",
                "required": [
                  "kind",
                  "ref",
                  "caption"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "animation",
                      "image"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "story only: named threads that group the events."
        },
        "timeline": {
          "type": "array",
          "minItems": 4,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "year",
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": "integer"
              },
              "thread": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "who": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "src": {
                "type": "string"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "further": {
          "type": "array",
          "maxItems": 3,
          "description": "The best resources to go further, found while scouting.",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "why": {
                "type": "string",
                "description": "One line: what this resource gives the learner."
              }
            }
          }
        },
        "emblem": {
          "type": "string",
          "description": "Optional. A small icon that stands for the concept (lamp, drop, gear, eye...). Shown on the house and in its room as a memory cue. See engine/src/gen/emblems.js for the names available."
        },
        "expert": {
          "type": "object",
          "description": "Optional. The person who lives in this concept's house and explains it: the house becomes their home, furnished for their trade, and they are its host. See references/3-path.md (places).",
          "required": [
            "trade"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Their first name, 8 characters at most (it goes on the name plate). Optional: the engine picks one."
            },
            "trade": {
              "type": "string",
              "description": "One of the trades in engine/src/gen/interior/trades.js (cartographer, dyer, cook, musician, gardener, clockmaker, doctor, painter, scholar, potter, weaver, printer). Any other word gives a generic home."
            },
            "line": {
              "type": "string",
              "description": "Optional. One sentence in their voice that carries the concept's idea; it is what they say first. 30 words at most."
            },
            "temper": {
              "type": "string",
              "description": "Optional. How they duel and how they hand over the key when beaten: one of the tempers in engine/src/mechanics/duel/tempers.js (smitten, sore, admirer, letwin, theatrical, absent, craftsman). Without it, or with an unknown word, the engine picks one by seed."
            }
          }
        },
        "riddles": {
          "type": "array",
          "maxItems": 3,
          "description": "Optional. Locks with free answers that guard advanced material: a safe, a computer, a door with a hatch. Never needed to finish. See references/7-progression.md.",
          "items": {
            "$ref": "#/$defs/riddle"
          }
        }
      }
    },
    "station": {
      "type": "object",
      "required": [
        "id",
        "tab",
        "goal",
        "pattern",
        "object",
        "action",
        "surprise",
        "tries",
        "takeaway",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "tab": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "description": "The idea as a sentence, 26 words at most."
        },
        "beat": {
          "enum": [
            "ground",
            "rule",
            "twist",
            "sandbox"
          ]
        },
        "pattern": {
          "enum": [
            "handle",
            "cause-effect",
            "break-it",
            "predict-test",
            "contrast",
            "zoom",
            "match",
            "step-through",
            "sort-cases",
            "linked-analogy",
            "puzzle",
            "role-play",
            "sandbox"
          ]
        },
        "object": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "surprise": {
          "type": "string"
        },
        "predict": {
          "type": "object",
          "required": [
            "q",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "string"
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the option that the exploration shows to be right. The lab states the verdict after the tasks."
            },
            "why": {
              "type": "string",
              "description": "Optional. One short sentence saying why the answer is right, shown with the verdict after the tasks (\"Red and green light add up to yellow.\"). May use <b>."
            }
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "tries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "takeaway": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "advanced": {
          "type": "boolean",
          "description": "Optional. The station belongs on the house's upper floor (opened by the owner's key), not in the ground-floor lab and not in the main path's count. See references/7-progression.md."
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "level",
        "q",
        "options",
        "answer",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "q": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": "string"
        },
        "traps": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "For each option, the mistake it catches; null for the right one."
        }
      }
    },
    "riddle": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "clue",
        "answer",
        "from",
        "inside"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique in the course."
        },
        "kind": {
          "type": "string",
          "description": "safe, computer or door (engine/src/mechanics/riddles/kinds.js). Another word gives a safe."
        },
        "clue": {
          "type": "string",
          "description": "What is written on the sticky note, or what the voice behind the door asks. Short: a mnemonic someone would really leave, never a textbook question."
        },
        "answer": {
          "description": "One accepted answer or a list of them: a short term (three words at most) or one number.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          ]
        },
        "type": {
          "enum": [
            "text",
            "number",
            "code"
          ],
          "description": "Default: number when the answer is a number, text otherwise. A code is matched digit by digit."
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Numbers only: how far off an answer may be. Default: exact for an integer."
        },
        "unit": {
          "type": "string",
          "description": "Numbers only: shown beside the input; a unit typed after the number is ignored."
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the answer is taught, for the thought after a wrong answer: the reading wall (page) or a lab station, of this concept or another (concept).",
          "properties": {
            "page": {
              "type": "boolean"
            },
            "station": {
              "type": "string"
            },
            "concept": {
              "type": "string"
            }
          }
        },
        "inside": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "What the lock guards: something worth the effort.",
          "properties": {
            "note": {
              "type": "string",
              "description": "A short secret text, 1 to 4 sentences: an advanced insight."
            },
            "station": {
              "type": "string",
              "description": "The id of an advanced station of this concept, opened from the lock."
            },
            "link": {
              "type": [
                "integer",
                "string"
              ],
              "description": "One of the concept's further links: its index (0 = the first) or its url."
            },
            "coins": {
              "type": "integer",
              "minimum": 1
            },
            "tool": {
              "type": "string",
              "description": "A tool of engine/src/mechanics/obstacles/kinds.js (key, pickaxe, saw, shears)."
            },
            "key": {
              "type": "string",
              "description": "The id of a concept: the key of its upper floor."
            }
          }
        },
        "where": {
          "type": "string",
          "description": "upstairs (default) or room (on the ground floor of the house). Any other text is a placement hint and counts as upstairs."
        }
      }
    }
  }
}
