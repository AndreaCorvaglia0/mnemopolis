{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course knowledge base",
  "description": "A course as data. Concepts are listed in the order of the learning path. Limits on counts and lengths are checked by scripts/validate.mjs.",
  "type": "object",
  "required": [
    "version",
    "id",
    "language",
    "title",
    "subject",
    "bigIdea",
    "themes",
    "concepts",
    "relations",
    "finalCheck"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique slug. Also the key of the learner's saved progress."
    },
    "language": {
      "type": "string",
      "description": "Language of the course, e.g. en, it."
    },
    "title": {
      "description": "Name of the course as the learner sees it.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "subject": {
      "description": "One line: what the course is about.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "bigIdea": {
      "description": "One claim, 28 words at most, from which the course follows.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "learner": {
      "description": "Who it is for and what they already know.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "listed": { "type": "boolean", "description": "false keeps the course off the site's front page (it is still built and playable at its address). Default true." },
    "pitch": {
      "description": "Optional. One line for the site's catalogue: what the learner gets, in their terms (about 20 words).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional. Up to four short words for the site's catalogue (for example science, colour)."
    },
    "level": {
      "enum": [
        "introductory",
        "intermediate",
        "advanced"
      ],
      "description": "Optional. Shown in the site's catalogue; introductory when absent."
    },
    "goals": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Concept ids that teach this goal. The ending card lists the goal only when each is core or was finished by the player. Leave out for a goal of the core path."
              }
            }
          }
        ]
      },
      "description": "What the learner can do at the end. Each starts with a verb. A goal taught only by extra concepts names them: { \"text\": \"...\", \"concepts\": [\"print\"] }."
    },
    "credit": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/langText"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "tier"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "url": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "note": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "idea"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "name": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "idea": {
            "description": "The theme as one sentence, 18 words at most.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "cue": {
            "type": "object",
            "additionalProperties": false,
            "description": "A memory cue for the theme. All themes must differ.",
            "properties": {
              "landscape": {
                "enum": [
                  "river",
                  "shore",
                  "forest",
                  "meadow",
                  "hill"
                ]
              },
              "landmark": {
                "enum": [
                  "fountain",
                  "obelisk",
                  "statue",
                  "arch",
                  "bell",
                  "stones"
                ]
              },
              "why": {
                "description": "The link with the content, only if an honest one exists.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "requires",
              "part-of",
              "causes",
              "contrasts",
              "same-structure",
              "example-of",
              "used-in"
            ],
            "description": "Read as: from <type> to. 'requires' means from cannot be understood without to."
          },
          "note": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        }
      }
    },
    "games": {
      "type": "array",
      "description": "Optional mini-games: short arcade-like rounds of one skill, started by an interaction in town. Never part of the main path. references/10-games.md; checked by engine/src/mechanics/games/spec.js.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "concepts",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "description": "At most 5 words.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "concepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "The concepts it practises; it opens once each is remembered (or its lab done, with unlock: lab)."
          },
          "unlock": {
            "enum": [
              "remembered",
              "lab"
            ]
          },
          "kind": {
            "enum": [
              "which",
              "match-fast",
              "sort-fast",
              "odd-one-out",
              "sequence",
              "estimate",
              "custom"
            ]
          },
          "where": {
            "enum": [
              "town",
              "person",
              "host"
            ]
          },
          "object": {
            "enum": [
              "piano",
              "board",
              "hat",
              "box",
              "bench"
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 20
          },
          "learn": {
            "description": "One line on the result screen, at most 16 words.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "data": {
            "type": "object",
            "description": "What the kind needs (references/10-games.md)."
          }
        }
      }
    },
    "withheld": {
      "type": "array",
      "maxItems": 6,
      "description": "Optional: things a person starts to tell and stops, told once the player's experience reaches a tier; kept in the notebook's Clues. Optional knowledge only.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "told"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "description": "A concept id (that house's owner tells it) or town."
          },
          "tier": {
            "enum": [
              "passing",
              "settling",
              "known",
              "home"
            ]
          },
          "teaser": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "told": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        }
      }
    },
    "finalCheck": {
      "type": "object",
      "required": [
        "name",
        "size",
        "pass"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 4,
          "maximum": 20
        },
        "pass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "languages": {
      "type": "array",
      "description": "Languages the course is written in, e.g. [\"en\",\"it\"]. Optional: default is just \"language\". Every text then carries all of them, as { \"en\": ..., \"it\": ... }. \"language\" is the default and the fallback.",
      "items": {
        "enum": [
          "en",
          "it"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": [
        "id",
        "theme",
        "type",
        "name",
        "place",
        "objective",
        "idea",
        "wrongBelief",
        "remember",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "boolean",
          "default": true,
          "description": "Optional. false makes this an extra concept: its house stays in town for the curious, but the main story (about an hour) and the final check do not need it. Keep a core of roughly 4 to 6 concepts. See references/3-path.md (core and extra)."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "theme": {
          "type": "string"
        },
        "type": {
          "enum": [
            "mechanism",
            "process",
            "view",
            "parts",
            "choice",
            "cases",
            "story",
            "deep"
          ]
        },
        "name": {
          "description": "The concept, 2 to 5 words.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "place": {
          "description": "A short, picturable name for where this concept lives.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "sign": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 9
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "objective": {
          "description": "What the learner will be able to do. Starts with an observable verb.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "idea": {
          "description": "The concept as one sentence, 28 words at most.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "wrongBelief": {
          "description": "What people believe before. Drives the prediction, the surprise and the wrong options.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "anchor": {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "analogy",
                "metaphor",
                "example",
                "contrast"
              ]
            },
            "text": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "limits": {
              "description": "Where the anchor stops being true.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            }
          }
        },
        "application": {
          "description": "Where the learner will meet this in real life. Specific.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "remember": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        },
        "explain": {
          "type": "object",
          "required": [
            "q",
            "a"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "a": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            }
          }
        },
        "callbacks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "to",
              "how"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "string"
              },
              "how": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              }
            }
          }
        },
        "lab": {
          "type": "object",
          "required": [
            "title",
            "stations"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "stations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/station"
              }
            }
          }
        },
        "page": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "text": {
                "description": "Under about 120 words.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "figure": {
                "type": "object",
                "required": [
                  "kind",
                  "ref",
                  "caption"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "animation",
                      "image"
                    ]
                  },
                  "ref": {
                    "type": "string"
                  },
                  "caption": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/langText"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "threads": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          },
          "description": "story only: named threads that group the events."
        },
        "timeline": {
          "type": "array",
          "minItems": 4,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "year",
              "title",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "year": {
                "type": "integer"
              },
              "thread": {
                "type": "string"
              },
              "title": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "who": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "text": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "why": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "src": {
                "type": "string"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "further": {
          "type": "array",
          "maxItems": 3,
          "description": "The best resources to go further, found while scouting.",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              },
              "url": {
                "type": "string"
              },
              "why": {
                "description": "One line: what this resource gives the learner.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              }
            }
          }
        },
        "emblem": {
          "type": "string",
          "description": "Optional. A small icon that stands for the concept (lamp, drop, gear, eye...). Shown on the house and in its room as a memory cue. See engine/src/gen/emblems.js for the names available."
        },
        "expert": {
          "type": "object",
          "description": "Optional. The person who lives in this concept's house and explains it: the house becomes their home, furnished for their trade, and they are its host. See references/3-path.md (places).",
          "required": [
            "trade"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Their first name, 8 characters at most (it goes on the name plate). Optional: the engine picks one.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "trade": {
              "type": "string",
              "description": "One of the trades in engine/src/gen/interior/trades.js (cartographer, dyer, cook, musician, gardener, clockmaker, doctor, painter, scholar, potter, weaver, printer). Any other word gives a generic home."
            },
            "line": {
              "description": "Optional. One sentence in their voice that carries the concept's idea; it is what they say first. 30 words at most.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "temper": {
              "type": "string",
              "description": "Optional. How they duel and how they hand over the key when beaten: one of the tempers in engine/src/mechanics/duel/tempers.js (smitten, sore, admirer, letwin, theatrical, absent, craftsman). Without it, or with an unknown word, the engine picks one by seed."
            }
          }
        },
        "riddles": {
          "type": "array",
          "maxItems": 3,
          "description": "Optional. Locks with free answers that guard advanced material: a safe, a computer, a door with a hatch. Never needed to finish. See references/7-progression.md.",
          "items": {
            "$ref": "#/$defs/riddle"
          }
        }
      }
    },
    "station": {
      "type": "object",
      "required": [
        "id",
        "tab",
        "goal",
        "pattern",
        "object",
        "action",
        "surprise",
        "tries",
        "takeaway",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "tab": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "goal": {
          "description": "The idea as a sentence, 26 words at most.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "beat": {
          "enum": [
            "ground",
            "rule",
            "twist",
            "sandbox"
          ]
        },
        "pattern": {
          "enum": [
            "handle",
            "cause-effect",
            "break-it",
            "predict-test",
            "contrast",
            "zoom",
            "match",
            "step-through",
            "sort-cases",
            "linked-analogy",
            "puzzle",
            "role-play",
            "sandbox"
          ]
        },
        "object": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "action": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "surprise": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
