        "predict": {
          "type": "object",
          "required": [
            "q",
            "options"
          ],
          "additionalProperties": false,
          "properties": {
            "q": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/langText"
                  }
                ]
              }
            },
            "answer": {
              "type": "integer",
              "minimum": 0,
              "description": "Index of the option that the exploration shows to be right. The lab states the verdict after the tasks."
            },
            "why": {
              "description": "Optional. One short sentence saying why the answer is right, shown with the verdict after the tasks (\"Red and green light add up to yellow.\"). May use <b>.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            }
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        },
        "tries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "1 to 3 tasks. A task is a string, or { \"text\", \"when\" }: the condition that ticks it (references/8-ready-labs.md, \"The tries vocabulary\"); a \"ready\" station needs the object form.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "text",
                  "when"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/langText"
                      }
                    ]
                  },
                  "when": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 1,
                    "description": "One verb: reach, cross, both, try, select, place, run, all, any (references/8-ready-labs.md)."
                  }
                }
              }
            ]
          }
        },
        "ready": {
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "Optional. A ready-made lab drawn by the engine from this data, when the concept's lab file has no code for this station (custom code wins). The data of each kind is in references/8-ready-labs.md; the validator checks it (engine/src/lab/patterns/specs.js).",
          "properties": {
            "kind": {
              "enum": [
                "slider-reveal",
                "compare",
                "sort",
                "order"
              ]
            },
            "caption": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "wide": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "tall": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "slider-reveal"
                }
              },
              "required": [
                "controls",
                "layers"
              ]
            },
            {
              "properties": {
                "kind": {
                  "const": "compare"
                }
              },
              "required": [
                "cases",
                "layers"
              ]
            },
            {
              "properties": {
                "kind": {
                  "const": "sort"
                }
              },
              "required": [
                "bins",
                "cards"
              ]
            },
            {
              "properties": {
                "kind": {
                  "const": "order"
                }
              },
              "required": [
                "steps"
              ]
            }
          ]
        },
        "takeaway": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "advanced": {
          "type": "boolean",
          "description": "Optional. The station belongs on the house's upper floor (opened by the owner's key), not in the ground-floor lab and not in the main path's count. See references/7-progression.md."
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "level",
        "q",
        "options",
        "answer",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "q": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              }
            ]
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "traps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/langText"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "For each option, the mistake it catches; null for the right one."
        }
      }
    },
    "riddle": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "clue",
        "answer",
        "from",
        "inside"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unique in the course."
        },
        "kind": {
          "type": "string",
          "description": "safe, computer or door (engine/src/mechanics/riddles/kinds.js). Another word gives a safe."
        },
        "clue": {
          "description": "What is written on the sticky note, or what the voice behind the door asks. Short: a mnemonic someone would really leave, never a textbook question.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/langText"
            }
          ]
        },
        "answer": {
          "description": "One accepted answer or a list of them: a short term (three words at most) or one number.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          ]
        },
        "type": {
          "enum": [
            "text",
            "number",
            "code"
          ],
          "description": "Default: number when the answer is a number, text otherwise. A code is matched digit by digit."
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Numbers only: how far off an answer may be. Default: exact for an integer."
        },
        "unit": {
          "type": "string",
          "description": "Numbers only: shown beside the input; a unit typed after the number is ignored."
        },
        "from": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the answer is taught, for the thought after a wrong answer: the reading wall (page) or a lab station, of this concept or another (concept).",
          "properties": {
            "page": {
              "type": "boolean"
            },
            "station": {
              "type": "string"
            },
            "concept": {
              "type": "string"
            }
          }
        },
        "inside": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "What the lock guards: something worth the effort.",
          "properties": {
            "note": {
              "description": "A short secret text, 1 to 4 sentences: an advanced insight.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/langText"
                }
              ]
            },
            "station": {
              "type": "string",
              "description": "The id of an advanced station of this concept, opened from the lock."
            },
            "link": {
              "type": [
                "integer",
                "string"
              ],
              "description": "One of the concept's further links: its index (0 = the first) or its url."
            },
            "coins": {
              "type": "integer",
              "minimum": 1
            },
            "tool": {
              "type": "string",
              "description": "A tool of engine/src/mechanics/obstacles/kinds.js (key, pickaxe, saw, shears)."
            },
            "key": {
              "type": "string",
              "description": "The id of a concept: the key of its upper floor."
            }
          }
        },
        "where": {
          "type": "string",
          "description": "upstairs (default) or room (on the ground floor of the house). Any other text is a placement hint and counts as upstairs."
        }
      }
    },
    "langText": {
      "type": "object",
      "description": "The same text in each language of the course: { \"en\": \"...\", \"it\": \"...\" }. Any text value may be a plain string or this object; the course's \"languages\" lists the languages it offers.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "it": {
          "type": "string"
        }
      }
    }
  }
